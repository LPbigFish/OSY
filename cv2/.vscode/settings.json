{
    "clangd.arguments": [
        "--background-index",
        "--clang-tidy"
    ],
    "[makefile]": {
        "editor.insertSpaces": false,
        "editor.detectIndentation": false,
        "editor.tabSize": 4
    }
    // clangd reads compile_commands.json from the workspace root (generated by:
    // make clean && bear -- make). No path override needed on a normal Linux install.
    //
    // NixOS only: run VS Code inside `nix develop` from the repo root (flake found
    // by searching upwards), or use the direnv extension, then uncomment:
    // "clangd.path": "clangd",
    // "lldb.library": "liblldb.so"
}
